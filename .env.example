# Environment variable names used by this project. Names only.
# Never put a value in this file: the repository is public.
# Real values are set in the hosting dashboard, or privately on your own machine.
# Delete any line you are not using: a blank value is not the same as an unset variable.
# When code reads a new variable, add its name here in the same commit.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Database: Supabase project URL. Required.
NEXT_PUBLIC_SUPABASE_URL=
# Database: server-side Supabase key. Required. Server only.
SUPABASE_SECRET_KEY=

# Admin: path segment of the admin area. Required.
ADMIN_PATH=
# Admin: secret used for admin sign-in. Required. Server only.
ADMIN_SECRET=
# Admin: secret for the admin one-time code. Required. Server only.
ADMIN_TOTP_SECRET=

# Scheduled jobs: shared secret for cron and ingest routes. Required. Server only.
CRON_SECRET=
# Email confirmation: signing secret for subscription tokens. Required. Server only.
JWT_SECRET=
# Email: Resend API key. Required. Server only.
RESEND_API_KEY=

# Bot check: Cloudflare Turnstile server secret for EthioTax. Required. Server only.
TURNSTILE_SECRET_KEY=
# Bot check: Cloudflare Turnstile server secret for AccountingBody. Required. Server only.
TURNSTILE_SECRET_KEY_AB=
# Bot check: Turnstile public site key for EthioTax. Required.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Bot check: Turnstile public site key for AccountingBody. Required.
NEXT_PUBLIC_TURNSTILE_SITE_KEY_AB=

# Error reporting: Sentry public DSN. Required in production for error reports.
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Required only for the feature named
# ---------------------------------------------------------------------------

# Admin AI tools: Anthropic API key. Optional. Server only.
ANTHROPIC_API_KEY=
# Job ingestion: Adzuna application ID. Optional.
ADZUNA_APP_ID=
# Job ingestion: Adzuna application key. Optional. Server only.
ADZUNA_APP_KEY=
# Social posting: Facebook page ID. Optional.
FB_PAGE_ID=
# Social posting: Facebook page access token. Optional. Server only.
FB_PAGE_ACCESS_TOKEN=

# Employer job payments: Lemon Squeezy API key. Optional. Server only.
LEMONSQUEEZY_API_KEY=
# Employer job payments: Lemon Squeezy store ID. Optional.
LEMONSQUEEZY_STORE_ID=
# Employer job payments: product variant priced in GBP. Optional.
LEMONSQUEEZY_VARIANT_ID_GBP=
# Employer job payments: product variant priced in USD. Optional.
LEMONSQUEEZY_VARIANT_ID_USD=
# Employer job payments: webhook signing secret. Optional. Server only.
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Site: public base URL for this environment. Optional; set it on each environment you use.
NEXT_PUBLIC_SITE_URL=
# Email: address that receives admin notifications. Optional.
ADMIN_EMAIL=
# Analytics: Google Tag Manager ID. Optional.
NEXT_PUBLIC_GTM_ID=
# Advertising: AdSense ID. Optional.
NEXT_PUBLIC_ADSENSE_ID=
# Advertising: AdSense site verification. Optional.
NEXT_PUBLIC_ADSENSE_VERIFICATION=
# Error reporting: Sentry token used at build time. Optional. Server only.
SENTRY_AUTH_TOKEN=
# Jobs: switch for the similar-jobs feature. Optional; leave unset, the feature stays off.
SIMILAR_JOBS_ENABLED=

# Job providers: a provider's database settings can name further variables.
# Those names are set per provider and are not listed here.

# ---------------------------------------------------------------------------
# Set automatically by the platform: do not set these yourself
# ---------------------------------------------------------------------------

# CI
# NEXT_RUNTIME

# ---------------------------------------------------------------------------
# Legacy: scheduled for removal
# ---------------------------------------------------------------------------

# Sign-in provider public key. Legacy, scheduled for removal; keep it set until then.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Sign-in provider secret key. Legacy, scheduled for removal; keep it set until then. Server only.
CLERK_SECRET_KEY=
# Old content system: project ID. Legacy, scheduled for removal.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Old content system: dataset name. Legacy, scheduled for removal.
NEXT_PUBLIC_SANITY_DATASET=
# Old content system: API token, also read by old files in scripts/. Legacy, scheduled for removal.
SANITY_API_TOKEN=
# Old job source: Careerjet API key. Legacy, scheduled for removal.
NEXT_PUBLIC_CAREERJET_API_KEY=
# Old job source: proxy address. Legacy, scheduled for removal.
FIXIE_URL=
# Old job source: second proxy address. Legacy, scheduled for removal.
FIXIE_URL_2=
# Old job source: database key name. Legacy, scheduled for removal. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Listed on the admin settings page only; not read elsewhere. Legacy, scheduled for removal.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
